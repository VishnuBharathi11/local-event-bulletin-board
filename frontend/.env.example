# Browser-visible API configuration only.
# Local Vite development uses /api with the proxy configured in vite.config.js.
VITE_API_BASE_URL=/api

# Optional public URL used when generating shared event links.
# If omitted, the browser's current origin is used.
VITE_PUBLIC_APP_URL=http://localhost:5173

# Firebase Web App configuration for Google Authentication.
# These are public client configuration values, not service-account credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
