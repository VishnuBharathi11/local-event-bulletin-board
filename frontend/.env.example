# Browser-visible API configuration only.
# Local Vite development uses /api with the proxy configured in vite.config.js.
VITE_API_BASE_URL=/api

# Optional public URL used when generating shared event links.
# If omitted, the browser's current origin is used.
VITE_PUBLIC_APP_URL=http://localhost:5173
