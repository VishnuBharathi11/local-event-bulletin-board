PORT=5000

# Firebase Admin configuration is server-only.
# Prefer Application Default Credentials in Cloud Run.
# For local development, either authenticate with Google Application Default Credentials
# or provide the following individual values from a secure local environment.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-only signing secret. Use a random value of at least 32 characters.
AUTH_JWT_SECRET=

# Optional cookie SameSite override. Use Lax locally and None for cross-site HTTPS deployments.
AUTH_COOKIE_SAMESITE=Lax

# Optional comma-separated origins for local/hosted browser clients.
CORS_ORIGINS=http://localhost:5173

# Google Cloud Storage bucket name for event images.
GCS_BUCKET_NAME=

# Server-only Google location provider configuration.
# GOOGLE_PLACES_API_KEY is preferred for Phase 6.2 venue search.
# GOOGLE_GEOCODING_API_KEY remains supported for the existing coordinate/district service
# and is also accepted as a fallback for venue search in existing local setups.
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# Server-only Vertex AI embedding configuration for EventHive Phase 5.1.
# Authenticate with Google Application Default Credentials; do not expose credentials to the browser.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
EMBEDDING_DIMENSIONS=768
EMBEDDING_CONFIG_VERSION=phase5.1-v1
